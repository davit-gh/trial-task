{
  "name": "capslock-tests",
  "version": "1.0.0",
  "description": "Playwright tests for Capslock Walk-In Bath form",
  "scripts": {
    "test": "playwright test",
    "test:top5": "playwright test top-5-scenarios",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "prettier": "^3.8.0",
    "typescript": "^5.3.0"
  }
}
